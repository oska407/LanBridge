<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.1.9j：地址卡片可点击（手动刷新 IP），用 ripple 包住原 bg_system_card 的造型，
  点击时有水波纹反馈。造型必须与 bg_system_card 完全一致（同底/同圆角/同描边）。
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/brand_100">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_50" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/brand_500" />
        </shape>
    </item>
</ripple>
