<?xml version="1.0" encoding="utf-8"?>
<!-- 预览页（微信样式，深色）：顶栏(返回 | i/N | 选择) + 大图翻页 + 缩略图条 + 底栏(原图 | 发送(N)) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp"
        android:background="#1A1A1A">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/n_white"
            android:textSize="@dimen/font_title"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_title" />

        <TextView
            android:id="@+id/tvIndex"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/n_white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnToggle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingHorizontal="8dp"
            android:text="@string/preview_select"
            android:textColor="@color/n_white"
            android:textSize="@dimen/font_body"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/thumbs"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:paddingVertical="8dp"
        android:paddingHorizontal="6dp"
        android:clipToPadding="false"
        android:background="#1A1A1A"
        android:overScrollMode="never" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#1A1A1A">

        <CheckBox
            android:id="@+id/cbOriginal"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/gallery_original"
            android:textColor="@color/n_white"
            android:textSize="@dimen/font_body" />

        <TextView
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:minWidth="96dp"
            android:paddingHorizontal="16dp"
            android:textColor="@color/n_white"
            android:background="@drawable/bg_btn_primary" />
    </LinearLayout>
</LinearLayout>
