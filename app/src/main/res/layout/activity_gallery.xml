<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/n_bg">

    <!-- 顶部导航（二级页保留返回箭头） -->
    <LinearLayout
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp"
        android:background="@color/n_surface">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="←"
            android:textSize="@dimen/font_title"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_title" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/gallery_title"
            android:textColor="@color/n_text_primary"
            android:textSize="@dimen/font_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/n_text_secondary"
            android:textSize="@dimen/font_caption" />
    </LinearLayout>

    <!-- 划选提示条 -->
    <TextView
        android:id="@+id/tvHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:text="@string/gallery_drag_hint"
        android:textColor="@color/n_text_secondary"
        android:textSize="@dimen/font_caption" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:background="@android:color/black" />

    <!-- 底部操作栏：预览(N) + [原图 空心圆] + [打包 空心圆] + 发送(N)
         原图与打包为相互独立的两个开关（需求③④）。
         高度 wrap_content：导航栏弹出时 inset 加为 padding，栏体背景自动延伸到导航栏下方。 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/n_surface">

        <TextView
            android:id="@+id/btnPreview"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingHorizontal="8dp"
            android:textColor="@color/n_text_primary"
            android:textSize="@dimen/font_body"
            android:background="?attr/selectableItemBackground" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 原图：空心圆开关 -->
        <LinearLayout
            android:id="@+id/layOriginal"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:background="?attr/selectableItemBackground">

            <View
                android:id="@+id/ivOriginal"
                android:layout_width="@dimen/gallery_toggle_size"
                android:layout_height="@dimen/gallery_toggle_size"
                android:background="@drawable/bg_toggle_off" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/gallery_original"
                android:textColor="@color/n_text_primary"
                android:textSize="@dimen/font_body" />
        </LinearLayout>

        <!-- 打包：与原图独立的开关 -->
        <LinearLayout
            android:id="@+id/layPackage"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:background="?attr/selectableItemBackground">

            <View
                android:id="@+id/ivPackage"
                android:layout_width="@dimen/gallery_toggle_size"
                android:layout_height="@dimen/gallery_toggle_size"
                android:background="@drawable/bg_toggle_off" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/gallery_package"
                android:textColor="@color/n_text_primary"
                android:textSize="@dimen/font_body" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:minWidth="96dp"
            android:paddingHorizontal="16dp"
            android:textColor="@color/n_white"
            android:background="@drawable/bg_btn_primary" />
    </LinearLayout>
</LinearLayout>
