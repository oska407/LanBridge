<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textColor="@color/n_text_secondary"
        android:textSize="@dimen/font_caption"
        android:paddingVertical="4dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:paddingVertical="2dp"
        android:background="?attr/selectableItemBackground">

        <!-- 多选空心圆（v1.1.8）：未选=灰描边空心圆，选中=品牌蓝实心+白✓；
             位于气泡左侧（发出消息也一样在左，保证勾选位固定，不随左右分列跳动）；
             圆圈自身也是一个热区，点它等价于点整行切换勾选。
             显隐/勾选态由 ChatAdapter.bindSelection() 通过 payload 局部刷新驱动。 -->
        <TextView
            android:id="@+id/cbSelect"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:textColor="@color/n_white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_select_off"
            android:visibility="gone" />

        <!-- 气泡 -->
        <LinearLayout
            android:id="@+id/bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/bubble_max_width"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="@drawable/bg_bubble_in">

            <TextView
                android:id="@+id/tvText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/n_text_primary"
                android:textSize="@dimen/font_body"
                android:textIsSelectable="true"
                android:visibility="gone" />

            <!-- 图片/视频预览：按实际长宽比，max 168×224（v1.1.7 缩小 30%），不再强制正方形（需求①） -->
            <FrameLayout
                android:id="@+id/imageWrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/chat_image_max_width"
                    android:maxHeight="@dimen/chat_image_max_height"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <!-- 视频播放角标：覆盖整个视频区域 -->
                <TextView
                    android:id="@+id/tvPlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="@color/n_white"
                    android:textSize="20sp"
                    android:background="#33000000"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- 文件消息（v1.1.9d 微信样式）：文件名+大小在左，格式图标在右。
                 图标=彩色页面形（按扩展名选 ic_file_*），字母徽标（PDF/W/X/P/?）由
                 tvFileBadge 覆盖显示；TXT/ZIP/音频的图形已画进图标内，徽标隐藏。 -->
            <LinearLayout
                android:id="@+id/fileRow"
                android:layout_width="224dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvFileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/n_text_primary"
                        android:textSize="@dimen/font_body"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvFileSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/n_text_secondary"
                        android:textSize="@dimen/font_caption" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp">

                    <ImageView
                        android:id="@+id/ivFileIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvFileBadge"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@color/n_white"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/n_text_secondary"
                android:textSize="@dimen/font_caption"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnResend"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="@string/resend"
                android:textColor="@color/danger_text"
                android:background="?attr/selectableItemBackground"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 系统卡片（连接地址）用：复制按钮 -->
        <TextView
            android:id="@+id/btnCopy"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="@string/copy_link"
            android:textColor="@color/brand_700"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
