<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/chat_bg">

    <!-- 标题栏（根页面，无返回箭头）
         v1.1.9b：加大底部留白（8dp→16dp）——用户要求标题「LanBridge」与聊天区的间距拉开 -->
    <LinearLayout
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:background="@color/n_surface">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/n_text_primary"
            android:textSize="@dimen/font_title"
            android:textStyle="bold" />

        <View
            android:id="@+id/statusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_circle_unchecked" />

        <TextView
            android:id="@+id/tvConn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/waiting_connection"
            android:textColor="@color/n_text_secondary"
            android:textSize="@dimen/font_caption" />
    </LinearLayout>

    <!-- 气泡区（安卓无滚动条，手指滑动 + fling） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="always"
        android:paddingVertical="8dp" />

    <!-- 多选模式：标题化操作行（标题栏变化 + 底部操作栏见 selectionBar） -->
    <LinearLayout
        android:id="@+id/selectionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="@color/n_surface"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnSelExit"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="取消"
            android:textSize="@dimen/font_title"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tvSelCount"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:textColor="@color/n_text_primary"
            android:textSize="@dimen/font_body" />

        <TextView
            android:id="@+id/btnSelAll"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/select_all"
            android:textColor="@color/brand_700"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <!-- 底部操作栏（多选时替换输入区+工具条）：保存 / 转发 / 复制 / 删除 -->
    <LinearLayout
        android:id="@+id/selectionActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/n_surface"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnSaveBatch"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="@string/menu_save"
            android:textColor="@color/n_text_primary"
            android:textSize="@dimen/font_body"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btnForwardBatch"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="@string/menu_forward"
            android:textColor="@color/n_text_primary"
            android:textSize="@dimen/font_body"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btnCopyBatch"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="@string/menu_copy"
            android:textColor="@color/n_text_primary"
            android:textSize="@dimen/font_body"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btnDeleteBatch"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="@string/menu_delete"
            android:textColor="@color/danger_text"
            android:textSize="@dimen/font_body"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <!-- 工具条（安卓四项：发文件/发照片/设置/清空，末位标红）
         v1.1.7c：图标 + 文字改纵向容器（见 styles.xml ToolItem 注释），
         容器高度 64dp，上下留白由容器精确控制，图标不再顶到上缘。 -->
    <LinearLayout
        android:id="@+id/toolBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/n_surface">

        <LinearLayout android:id="@+id/btnFile" style="@style/ToolItem">
            <ImageView style="@style/ToolIcon"
                android:src="@drawable/ic_tool_file"
                android:contentDescription="@null" />
            <TextView style="@style/ToolLabel" android:text="@string/toolbar_send_file" />
        </LinearLayout>

        <LinearLayout android:id="@+id/btnPhoto" style="@style/ToolItem">
            <ImageView style="@style/ToolIcon"
                android:src="@drawable/ic_tool_photo"
                android:contentDescription="@null" />
            <TextView style="@style/ToolLabel" android:text="@string/toolbar_send_photo" />
        </LinearLayout>

        <LinearLayout android:id="@+id/btnSettings" style="@style/ToolItem">
            <ImageView style="@style/ToolIcon"
                android:src="@drawable/ic_tool_settings"
                android:contentDescription="@null" />
            <TextView style="@style/ToolLabel" android:text="@string/toolbar_settings" />
        </LinearLayout>

        <LinearLayout android:id="@+id/btnClear" style="@style/ToolItem">
            <ImageView style="@style/ToolIcon"
                android:src="@drawable/ic_trash"
                android:contentDescription="@null" />
            <TextView style="@style/ToolLabel"
                android:text="@string/toolbar_clear"
                android:textColor="@color/danger_text" />
        </LinearLayout>
    </LinearLayout>

    <!-- 发送窗口：输入区 + 发送按钮 -->
    <LinearLayout
        android:id="@+id/composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:background="@color/n_surface">

        <!-- 发送区（v1.1.7c）：发送按钮内嵌到输入框内部右下角，
             尺寸 40dp 胶囊，不再与输入框并排等高；EditText 右侧留 88dp 内边距避让。
             v1.1.9：去掉顶部 padding（8dp→0）——工具条标签到输入框的间距
             必须 = 图标到工具栏上缘的间距（约 13dp），之前 8dp 顶距使下方留白偏大。 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <EditText
                android:id="@+id/etInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:maxLines="5"
                android:inputType="textMultiLine|textCapSentences"
                android:imeOptions="actionSend|flagNoExtractUi"
                android:hint="@string/input_hint"
                android:background="@drawable/bg_composer"
                android:paddingStart="16dp"
                android:paddingEnd="88dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:textSize="@dimen/font_body" />

            <TextView
                android:id="@+id/btnSend"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:minWidth="64dp"
                android:paddingHorizontal="14dp"
                android:text="@string/send"
                android:textColor="@color/n_white"
                android:textSize="14sp"
                android:background="@drawable/bg_btn_primary" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
