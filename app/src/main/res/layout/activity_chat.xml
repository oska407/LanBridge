<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/chat_bg">

    <!-- 标题栏（根页面，无返回箭头） -->
    <LinearLayout
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:background="@color/n_surface">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/n_text_primary"
            android:textSize="@dimen/font_title"
            android:textStyle="bold" />

        <View
            android:id="@+id/statusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_circle_unchecked" />

        <TextView
            android:id="@+id/tvConn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/waiting_connection"
            android:textColor="@color/n_text_secondary"
            android:textSize="@dimen/font_caption" />
    </LinearLayout>

    <!-- 气泡区（安卓无滚动条，手指滑动 + fling） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="always"
        android:paddingVertical="8dp" />

    <!-- 多选模式：标题化操作行（标题栏变化 + 底部操作栏见 selectionBar） -->
    <LinearLayout
        android:id="@+id/selectionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="@color/n_surface"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnSelExit"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="✕"
            android:textSize="@dimen/font_title"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tvSelCount"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:textColor="@color/n_text_primary"
            android:textSize="@dimen/font_body" />

        <TextView
            android:id="@+id/btnSelAll"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/select_all"
            android:textColor="@color/green_700"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <!-- 底部操作栏（多选时替换输入区+工具条） -->
    <LinearLayout
        android:id="@+id/selectionActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/n_surface"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnShareBatch"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="@string/menu_share_wechat"
            android:textColor="@color/n_white"
            android:background="@drawable/bg_btn_primary" />

        <TextView
            android:id="@+id/btnSaveBatch"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="@string/menu_save"
            android:textColor="@color/green_700"
            android:background="@drawable/bg_composer" />

        <TextView
            android:id="@+id/btnDeleteBatch"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="@string/menu_delete"
            android:textColor="@color/n_white"
            android:background="@drawable/bg_btn_primary" />
    </LinearLayout>

    <!-- 工具条（安卓五项：发文件/发照片/截屏/设置/清空，末位标红） -->
    <LinearLayout
        android:id="@+id/toolBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@color/n_surface">

        <TextView android:id="@+id/btnFile" style="@style/ToolItem" android:text="📁 发文件" android:contentDescription="@string/toolbar_send_file" />
        <TextView android:id="@+id/btnPhoto" style="@style/ToolItem" android:text="🖼 发照片" android:contentDescription="@string/toolbar_send_photo" />
        <TextView android:id="@+id/btnShot" style="@style/ToolItem" android:text="✂ 截屏" android:contentDescription="@string/toolbar_screenshot" />
        <TextView android:id="@+id/btnSettings" style="@style/ToolItem" android:text="⚙ 设置" android:contentDescription="@string/toolbar_settings" />
        <TextView android:id="@+id/btnClear" style="@style/ToolItem" android:text="🗑 清空" android:textColor="@color/danger_text" android:contentDescription="@string/toolbar_clear" />
    </LinearLayout>

    <!-- 发送窗口：输入区 + 发送按钮 -->
    <LinearLayout
        android:id="@+id/composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:padding="8dp"
        android:background="@color/n_surface">

        <EditText
            android:id="@+id/etInput"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:maxLines="5"
            android:inputType="textMultiLine|textCapSentences"
            android:imeOptions="actionSend|flagNoExtractUi"
            android:hint="@string/input_hint"
            android:background="@drawable/bg_composer"
            android:padding="12dp"
            android:textSize="@dimen/font_body" />

        <TextView
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:text="@string/send"
            android:textColor="@color/n_white"
            android:background="@drawable/bg_btn_primary" />
    </LinearLayout>
</LinearLayout>
