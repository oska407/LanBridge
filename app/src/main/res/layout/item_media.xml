<?xml version="1.0" encoding="utf-8"?>
<!-- 正方形网格项：以宽度为边长；1dp 外边距 + RecyclerView 黑底 => 照片间黑线分隔（需求①②） -->
<com.lanbridge.gallery.SquareFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="1dp">

    <ImageView
        android:id="@+id/ivThumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- 划选期间的半透明遮罩 -->
    <View
        android:id="@+id/viewMask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone" />

    <!-- 右上角选中圆点：选中变绿色序号徽章（与微信一致，显示勾选顺序号） -->
    <TextView
        android:id="@+id/viewCircle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:gravity="center"
        android:textColor="@color/n_white"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/bg_circle_unchecked" />
</com.lanbridge.gallery.SquareFrameLayout>
