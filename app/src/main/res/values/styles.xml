<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 工具条按钮容器（v1.1.7c）
         历史坑：原先是 TextView + drawableTop。TextView 的 compound drawable
         **不参与 gravity 的垂直居中计算** —— 框架只把文字居中，图标挂在文字上方，
         于是图标被顶到容器上缘，怎么调 padding 都压不下去（用户两次反馈「离上缘太近」）。
         改为纵向 LinearLayout（ImageView + TextView）后，间距完全由容器高度决定：
           容器 64dp，内容 = 24dp 图标 + 4dp + 约 14dp 文字 = 42dp，上下各余 11dp；
           图标内 2dp 安全区内缩 → 视觉上缘 13dp / 文字下缘约 12.5dp，均衡且宽松。
         热区仍为整条 64dp × 1/4 宽，远超 48dp 无障碍下限。 -->
    <style name="ToolItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 图标统一 24dp 网格（与 drawable 的 viewport 一致，不缩放、不失真） -->
    <style name="ToolIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
    </style>

    <style name="ToolLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/n_text_primary</item>
    </style>
</resources>
